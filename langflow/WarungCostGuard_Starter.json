    {
      "id": "flow-calculate-margin",
      "name": "Flow 2: calculate_margin",
      "description": "Perhitungan deterministik biaya efektif, susut, laba kotor, dan persentase margin riil",
      "data": {
        "nodes": [
          {
            "id": "ChatInput-margin",
            "type": "ChatInput",
            "data": {
              "node": {
                "template": {
                  "input_value": {
                    "value": "{\"purchase_price\": 36500, \"transport_cost\": 1500, \"waste_pct\": 5, \"selling_price\": 45000}"
                  }
                }
              }
            }
          },
          {
            "id": "PythonComponent-calc",
            "type": "CustomComponent",
            "data": {
              "node": {
                "template": {
                  "code": "def calc_margin(purchase_price, transport_cost, waste_pct, selling_price):\n    eff_cost = round((purchase_price + transport_cost) / (1 - waste_pct / 100))\n    gross_profit = selling_price - eff_cost\n    margin_pct = round((gross_profit / selling_price) * 100, 2)\n    return {'effective_cost': eff_cost, 'gross_profit': gross_profit, 'gross_margin_pct': margin_pct}"
                }
              }
            }
          },
          {
            "id": "ChatOutput-margin",
            "type": "ChatOutput",
            "data": {
              "node": {
                "template": {
                  "input_value": {
                    "value": ""
                  }
                }
              }
            }
          }
        ]
      }
