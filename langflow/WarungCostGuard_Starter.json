                  "code": "def fetch_market_prices(commodity: str, city: str = 'Surabaya'):\n    # Connect to SP2KP / PIHPS / Bapanas aggregator\n    return {'commodity': commodity, 'city': city, 'median_reference': 43000, 'unit': 'kg'}"
