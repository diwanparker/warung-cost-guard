# 9router / OpenAI Compatible Provider (IBM Bob Agent Inference)
OPENAI_BASE_URL=https://9router.diwanparker.tech/v1
OPENAI_API_KEY=your_openai_or_9router_api_key_here
OPENAI_MODEL=Free
BOB_API_KEY=your_bob_or_openai_api_key_here

# BPS WebAPI (https://webapi.bps.go.id / https://datarakyat.id/docs/bps/)
BPS_API_KEY=your_bps_api_key_here
BPS_BASE_URL=https://webapi.bps.go.id/v1/api

# Market Data Sources (PIHPS, Bapanas, SP2KP)
PIHPS_BASE_URL=https://www.bi.go.id/hargapangan
BAPANAS_BASE_URL=https://panelharga.badanpangan.go.id
SP2KP_BASE_URL=https://sp2kp.kemendag.go.id

# Langflow Integration
LANGFLOW_BASE_URL=http://localhost:7860
LANGFLOW_API_KEY=your_langflow_api_key_here
LANGFLOW_FLOW_ID_MARKET_PRICES=your_flow_id_here
LANGFLOW_FLOW_ID_MARGIN=your_flow_id_here
LANGFLOW_FLOW_ID_ACTION=your_flow_id_here

# App Modes
DEMO_MODE=true
DEFAULT_CITY=Surabaya
NOTIFICATION_PROVIDER=mock
CACHE_TTL_SECONDS=300
